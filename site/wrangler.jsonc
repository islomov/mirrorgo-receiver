{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // alltvkit.app: All TV Kit's landing page (the app was called MirrorGo), also served as is on mirrorgo.app
  // (same pages; their canonical URLs are on alltvkit.app). Static files built by build.py into ./public; worker.js sends www.<domain>
  // to <domain> and the removed Roku articles to the Roku guide, and counts page views and link clicks
  // (POST /e from site.js) in the Analytics Engine dataset below.
  "name": "mirrorgo-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "mirrorgo.app", "custom_domain": true },
    { "pattern": "www.mirrorgo.app", "custom_domain": true },
    { "pattern": "alltvkit.app", "custom_domain": true },
    { "pattern": "www.alltvkit.app", "custom_domain": true }
  ],
  // Page views and clicks; `python3 stats.py` reads them.
  "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "mirrorgo_site" }],
  // Yesterday's numbers to Telegram at 09:00 UTC+5 (04:00 UTC): report.js, which lists the secrets it needs.
  "triggers": { "crons": ["0 4 * * *"] },
  "workers_dev": false,
  "preview_urls": false
}
