{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // mirrorgo.app: MirrorGo's landing page. Static files built by build.py into ./public; worker.js
  // sends www.mirrorgo.app to mirrorgo.app and the removed Roku articles to the Roku guide, and counts
  // page views and link clicks (POST /e from site.js) in the Analytics Engine dataset below.
  "name": "mirrorgo-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "mirrorgo.app", "custom_domain": true },
    { "pattern": "www.mirrorgo.app", "custom_domain": true }
  ],
  // Page views and clicks; `python3 stats.py` reads them.
  "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "mirrorgo_site" }],
  "workers_dev": false,
  "preview_urls": false
}
