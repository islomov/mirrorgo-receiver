{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smrr",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Static site from ../web; the Worker runs first so it can redirect www and
  // handle /ws, /api/* and /c/<code>.
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "smrr.tv", "custom_domain": true },
    { "pattern": "www.smrr.tv", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // One Durable Object per room (id = idFromName(code)), see src/room.ts and PROTOCOL.md.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // Per-IP limits (Workers Rate Limiting, approximate and per Cloudflare location).
  // LOOKUP_LIMITER: GET /api/rooms/:code (code guessing). SENDER_LIMITER: sender
  // WebSocket upgrades, whose 404/403 would otherwise tell live codes apart too.
  "ratelimits": [
    { "name": "LOOKUP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SENDER_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    // Handed to both peers in `room` / `ready`. v1: STUN only (no TURN).
    "ICE_SERVERS": [{ "urls": ["stun:stun.cloudflare.com:3478"] }]
  }
}
