{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smrr",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Static site from ../web; the Worker runs first so it can redirect www and
  // handle /ws, /api/* and /c/<code>.
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "smrr.tv", "custom_domain": true },
    { "pattern": "www.smrr.tv", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // One Durable Object per room (id = idFromName(code)), see src/room.ts and PROTOCOL.md.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // Per-IP limits (Workers Rate Limiting, approximate and per Cloudflare location).
  // LOOKUP_LIMITER: GET /api/rooms/:code (code guessing). SENDER_LIMITER: sender
  // WebSocket upgrades, whose 404/403 would otherwise tell live codes apart too.
  // CREATE_LIMITER: POST /api/rooms (the app opening the TV's browser on a new room) and new rooms
  // from POST /api/viewer. VIEWER_LIMITER: new rooms from a page's WebSocket (a reload rejoins its
  // room and isn't counted), so the codes can't all be taken. IPv6 clients count per /64.
  // WIDE_LIMITER: lookups and new rooms again, per IPv6 /48 (one key per endpoint), since a /48 is
  // 65,536 /64s. RELAY_LIMITER: the other requests that wake a Room (HTTP viewers' polls and sends,
  // rejoins), so a flood of made-up codes and tokens can't run up Durable Object requests.
  "ratelimits": [
    { "name": "LOOKUP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SENDER_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "CREATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "VIEWER_LIMITER", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "WIDE_LIMITER", "namespace_id": "1005", "simple": { "limit": 100, "period": 60 } },
    { "name": "RELAY_LIMITER", "namespace_id": "1006", "simple": { "limit": 300, "period": 60 } }
  ],

  "vars": {
    // Handed to both peers in `room` / `ready`. v1: STUN only (no TURN).
    "ICE_SERVERS": [{ "urls": ["stun:stun.cloudflare.com:3478"] }],
    // GET /version: the newest app release that's known to work with smrr.tv. Bump it here
    // (a push to main deploys) once a release is out and checked.
    "APP_VERSION": "1.0.0"
  }
}
